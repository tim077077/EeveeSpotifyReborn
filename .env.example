# Any one AI key works. Everything below can also be set from the dashboard (Settings).
# The provider is detected from the key: sk-ant- (Anthropic), sk- (OpenAI), AIza (Gemini),
# sk-or- (OpenRouter), gsk_ (Groq), xai- (xAI). Provider-named vars work too:
# ANTHROPIC_API_KEY, OPENAI_API_KEY, GEMINI_API_KEY, OPENROUTER_API_KEY, GROQ_API_KEY, ...
LLM_API_KEY=
# anthropic | openai | gemini | openrouter | groq | deepseek | xai | mistral | together | ollama | custom
LLM_PROVIDER=
LLM_MODEL=
# For ollama / custom OpenAI-compatible servers / proxies
LLM_BASE_URL=
# Claude thinking effort (Claude models only): low | medium | high
ANTHROPIC_EFFORT=medium

# AI backgrounds: openai | gemini | together | pollinations. Blank = reuse the AI key when it
# can make images (OpenAI, Gemini), else Pollinations (free, watermarked).
IMAGE_PROVIDER=
IMAGE_API_KEY=
IMAGE_MODEL=

# Stock photo backgrounds (optional)
PEXELS_API_KEY=
UNSPLASH_ACCESS_KEY=

# Slideshow library discovery by keyword/hashtag (optional; https://apify.com)
APIFY_TOKEN=

# TikTok developer app (Login Kit + Content Posting API)
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_DIRECT_POSTS_PER_DAY=6
TIKTOK_FALLBACK_TO_DRAFT=true

# Public HTTPS URL of this server. TikTok downloads slide images from here,
# so this domain must be verified in the TikTok developer portal.
PUBLIC_BASE_URL=http://localhost:8000

# Protects the dashboard + API. Leave empty only for local use.
SLIDEMILL_API_KEY=
SLIDEMILL_TIMEZONE=America/Los_Angeles
MAX_CONCURRENT_GENERATIONS=3
